{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account profile and authentication data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "passwordHash": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transaction or activity record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Customer support inquiry ticket",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "userId"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User system notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" }
      },
      "required": ["id", "userId"]
    },
    "Swap": {
      "title": "Swap",
      "description": "Cryptocurrency swap request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "fromAsset": { "type": "string" },
        "toAsset": { "type": "string" },
        "amount": { "type": "number" },
        "usdtEquivalent": { "type": "number" },
        "status": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["id", "userId", "fromAsset", "toAsset", "amount", "status"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User documents keyed by user ID"
    },
    "swaps/{swapId}": {
      "schema": { "$ref": "#/entities/Swap" },
      "description": "Crypto swap submissions and records"
    },
    "transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Transaction records"
    },
    "supportTickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Support tickets"
    },
    "notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Notifications"
    }
  }
}
